{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "ask",
      "ls*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git branch*": "allow",
      "git switch -c *": "allow",
      "git checkout -b *": "allow",
      "git add *": "allow",
      "git commit *": "allow",
      "python tools/build.py*": "allow",
      "node --check *": "allow",
      "git push *": "ask",
      "git tag *": "ask",
      "git merge *": "ask",
      "git rebase *": "ask",
      "curl *": "ask",
      "*api.github.com*": "ask",
      "*gh release*": "ask",
      "*gh pr merge*": "ask",
      "git push --force*": "deny",
      "git push -f*": "deny",
      "git push origin main*": "deny",
      "git push * main": "deny",
      "git push * HEAD:main*": "deny",
      "git reset --hard*": "deny",
      "git config --global*": "deny",
      "*git credential*": "deny",
      "*git-credential*": "deny",
      "rm -rf *": "deny",
      "gh pr create*": "allow",
      "gh pr view*": "allow",
      "gh pr list*": "allow",
      "gh pr checks*": "allow",
      "gh release create*": "allow",
      "gh release view*": "allow",
      "gh run list*": "allow",
      "gh run view*": "allow",
      "gh auth status*": "allow",
      "gh pr merge*": "deny",
      "gh release delete*": "deny",
      "gh repo delete*": "deny"
    }
  }
}
